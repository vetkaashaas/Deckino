{
  "expo": {
    "name": "Deckino",
    "slug": "deckino",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deckino",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Deckino uses the camera to identify Magic: The Gathering cards."
      }
    },
    "android": {
      "package": "com.deckino.app",
      "adaptiveIcon": {
        "backgroundColor": "#981DCE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "deckino.com", "pathPrefix": "/deck/" },
            { "scheme": "https", "host": "deckino.com", "pathPrefix": "/binder/" },
            { "scheme": "https", "host": "deckino.com", "pathPrefix": "/cards/" },
            { "scheme": "https", "host": "deckino.com", "path": "/verify-email" },
            { "scheme": "https", "host": "deckino.com", "path": "/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#981DCE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-dev-client",
      "expo-asset",
      "onnxruntime-react-native",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "text/plain"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Lexend",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/lexend/500Medium/Lexend_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/lexend/700Bold/Lexend_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Bricolage",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0610"
  }
}
