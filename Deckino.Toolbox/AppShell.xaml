<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Deckino.Toolbox.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:ShellViewModel"
    BackgroundColor="{StaticResource Graphite900}"
    Shell.NavBarIsVisible="False">

    <Grid x:Name="ShellLayout" ColumnDefinitions="220,1,*">
        <Grid Grid.Column="0" BackgroundColor="{StaticResource Graphite850}" RowDefinitions="Auto,*">
            <Grid Padding="12,16,12,8" ColumnDefinitions="32,*" ColumnSpacing="10">
                <Border WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource Accent}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                    <Label Text="D" FontFamily="OpenSansSemibold" FontSize="16"
                           TextColor="{StaticResource AccentInk}" HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout x:Name="BrandText" Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="DECKINO" FontFamily="OpenSansSemibold" FontSize="13" CharacterSpacing="1.2" />
                    <Label Text="TOOLBOX" Style="{StaticResource Eyebrow}" FontSize="10" TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="NavList" Padding="8,0,8,12" Spacing="2" />
            </ScrollView>
        </Grid>

        <BoxView Grid.Column="1" Color="{StaticResource Graphite700}" />
        <controls:WorkspaceHost Grid.Column="2" CurrentPage="{Binding CurrentPage}" />
    </Grid>
</ContentPage>
