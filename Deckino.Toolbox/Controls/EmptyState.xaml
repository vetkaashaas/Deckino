<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="6" Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
        <Label x:Name="GlyphLabel" Style="{StaticResource Icon}" FontSize="28"
               TextColor="{StaticResource DisabledText}" IsVisible="False" />
        <Label x:Name="TitleLabel" FontFamily="OpenSansSemibold" TextColor="{StaticResource SecondaryText}"
               HorizontalTextAlignment="Center" />
        <Label x:Name="MessageLabel" Style="{StaticResource Muted}" HorizontalTextAlignment="Center"
               IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
