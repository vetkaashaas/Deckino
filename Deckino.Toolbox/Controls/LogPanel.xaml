<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Controls.LogPanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource Surface}" Padding="0">
        <Grid RowDefinitions="Auto,*">
            <!-- LogPanel.xaml.cs drops the status line to the second row when the panel is narrow. -->
            <Grid Padding="16,6,8,6" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <Label Text="Activity log" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
                <Label x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource Muted}" MaxLines="1"
                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="2" Spacing="2">
                    <Button x:Name="OpenButton" Text="Open logs" Style="{StaticResource QuietButton}" />
                    <Button x:Name="ClearButton" Text="Clear" Style="{StaticResource QuietButton}" />
                    <Button x:Name="CopySelectedButton" Text="Copy line" Style="{StaticResource QuietButton}"
                            ToolTipProperties.Text="Copy the selected line" />
                    <Button x:Name="CopyAllButton" Text="Copy all" Style="{StaticResource QuietButton}" />
                </HorizontalStackLayout>
            </Grid>
            <!-- LogPanel.xaml.cs scrolls to the newest line itself; the list must not also move on updates. -->
            <CollectionView x:Name="Lines" Grid.Row="1" SelectionMode="Single"
                            ItemsUpdatingScrollMode="KeepScrollOffset"
                            SelectionChanged="OnSelectionChanged"
                            BackgroundColor="{StaticResource Graphite950}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" Style="{StaticResource Mono}" Padding="12,4" LineBreakMode="NoWrap" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
</ContentView>
