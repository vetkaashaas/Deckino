<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Controls.OverlayHost"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    IsVisible="False">
    <Grid>
        <!-- Modal layer: the scrim swallows pointer input for everything underneath. -->
        <Grid x:Name="DialogLayer" IsVisible="False" BackgroundColor="#B3090B0E">
            <Border x:Name="DialogCard" Style="{StaticResource Surface}" Padding="24,20,24,16"
                    MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center"
                    Margin="24">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.45" Radius="32" Offset="0,12" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                    <Label x:Name="DialogTitle" Style="{StaticResource SectionTitle}" FontSize="16"
                           LineBreakMode="WordWrap" />
                    <ScrollView Grid.Row="1" MaximumHeightRequest="320">
                        <Label x:Name="DialogMessage" TextColor="{StaticResource SecondaryText}"
                               LineBreakMode="WordWrap" LineHeight="1.25" />
                    </ScrollView>
                    <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="End" Margin="0,8,0,0">
                        <Button x:Name="CancelButton" Clicked="OnCancelClicked" />
                        <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Clicked="OnAcceptClicked" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast layer: never takes input. -->
        <Border x:Name="Toast" IsVisible="False" Opacity="0" InputTransparent="True"
                BackgroundColor="{StaticResource Graphite750}" Stroke="{StaticResource Graphite700}"
                StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="14,8"
                HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,28">
            <Label x:Name="ToastLabel" FontFamily="OpenSansSemibold" FontSize="12" LineBreakMode="NoWrap" />
        </Border>
    </Grid>
</ContentView>
