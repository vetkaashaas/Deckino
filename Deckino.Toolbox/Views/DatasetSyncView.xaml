<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Views.DatasetSyncView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:DatasetSyncViewModel">
    <ScrollView>
        <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
            <controls:PageHeader Title="{Binding DisplayName}" Subtitle="{Binding Description}">
                <controls:PageHeader.Status>
                    <!-- Text and tone are set in DatasetSyncView.xaml.cs from the sync safety state. -->
                    <controls:StatusPill x:Name="SafetyPill" />
                </controls:PageHeader.Status>
                <controls:PageHeader.Actions>
                    <Button Text="Sync now" Command="{Binding SyncNowCommand}" Style="{StaticResource PrimaryButton}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border Grid.Row="1" Style="{StaticResource Surface}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,1,*,1,*,1,*" ColumnSpacing="16" RowSpacing="12">
                    <controls:StatTile Heading="Local files" Value="{Binding LocalFiles, StringFormat='{0:N0}'}" />
                    <BoxView Grid.Column="1" Color="{StaticResource Graphite700}" WidthRequest="1" />
                    <controls:StatTile Grid.Column="2" Heading="Remote files" Value="{Binding RemoteFiles, StringFormat='{0:N0}'}" />
                    <BoxView Grid.Column="3" Color="{StaticResource Graphite700}" WidthRequest="1" />
                    <controls:StatTile Grid.Column="4" Heading="Pending uploads" Value="{Binding PendingUploads, StringFormat='{0:N0}'}" />
                    <BoxView Grid.Column="5" Color="{StaticResource Graphite700}" WidthRequest="1" />
                    <controls:StatTile Grid.Column="6" Heading="Failed operations" Value="{Binding FailedOperations, StringFormat='{0:N0}'}" />
                    <BoxView Grid.Row="1" Grid.ColumnSpan="7" Style="{StaticResource Divider}" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="7" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Label Text="{Binding Status}" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding LastSyncLabel, StringFormat='Last successful sync  {0}'}"
                               Style="{StaticResource Mono}" VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Two equal cards side by side; DatasetSyncView.xaml.cs stacks them when the view is narrow. -->
            <Grid x:Name="Panels" Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="16" RowSpacing="16">
                <controls:Card Title="Railway bucket connection"
                               Subtitle="Credentials stay encrypted for the current Windows user. Downloads run only on demand.">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                            <VerticalStackLayout><Label Text="Endpoint" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Endpoint}" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"><Label Text="Bucket" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Bucket}" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1"><Label Text="Region" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Region}" /></VerticalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8" VerticalOptions="End" Margin="0,0,0,2"><CheckBox IsChecked="{Binding ForcePathStyle}" /><Label Text="Use path-style URLs" VerticalOptions="Center" /></HorizontalStackLayout>
                            <VerticalStackLayout Grid.Row="2"><Label Text="Access key ID" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding AccessKeyId}" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1"><Label Text="Secret access key" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding SecretAccessKey}" IsPassword="True" /></VerticalStackLayout>
                        </Grid>
                        <Button Text="Verify and save connection" Command="{Binding SaveConnectionCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </controls:Card>

                <controls:Card x:Name="ConflictsCard" Grid.Column="1" Title="Conflicts"
                               Subtitle="Different local and remote content is never overwritten silently.">
                    <Grid RowDefinitions="*,Auto" RowSpacing="12">
                        <CollectionView ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}"
                                        SelectionMode="Single" MinimumHeightRequest="160">
                            <CollectionView.EmptyView>
                                <controls:EmptyState Glyph="&#xE73E;" Title="No conflicts" Message="Local and remote copies agree." />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Grid Padding="8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding RelativePath}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding CreatedUtc, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Mono}" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ObjectKey}" Style="{StaticResource Mono}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End">
                            <Button Text="Keep remote" Command="{Binding KeepRemoteCommand}" />
                            <Button Text="Keep local" Command="{Binding KeepLocalCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </controls:Card>
            </Grid>
        </Grid>
    </ScrollView>
</ContentView>
