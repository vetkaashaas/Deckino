<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Views.DatasetSyncView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:DatasetSyncViewModel">
    <ScrollView>
        <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
            <controls:PageHeader Title="{Binding DisplayName}" Subtitle="{Binding Description}">
                <controls:PageHeader.Actions>
                    <Button Text="Sync now" Command="{Binding SyncNowCommand}" Style="{StaticResource PrimaryButton}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border Grid.Row="1" Style="{StaticResource Surface}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,1,*,1,*,1,*" ColumnSpacing="16" RowSpacing="12">
                    <VerticalStackLayout Spacing="3"><Label Text="Sync safety" Style="{StaticResource Eyebrow}" /><Label Text="{Binding SafetyLabel}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Accent}" /><Label Text="{Binding Status}" Style="{StaticResource Muted}" /></VerticalStackLayout>
                    <BoxView Grid.Column="1" Color="{StaticResource Graphite700}" />
                    <controls:StatTile Grid.Column="2" Heading="Local files" Value="{Binding LocalFiles, StringFormat='{0:N0}'}" />
                    <BoxView Grid.Column="3" Color="{StaticResource Graphite700}" />
                    <controls:StatTile Grid.Column="4" Heading="Remote files" Value="{Binding RemoteFiles, StringFormat='{0:N0}'}" />
                    <BoxView Grid.Column="5" Color="{StaticResource Graphite700}" />
                    <controls:StatTile Grid.Column="6" Heading="Pending / failed" Value="{Binding PendingUploads, StringFormat='{0:N0}'}" Caption="{Binding FailedOperations, StringFormat='failed {0:N0}'}" />
                    <Label Grid.Row="1" Grid.ColumnSpan="7" Text="{Binding LastSyncLabel, StringFormat='Last successful sync  {0}'}" Style="{StaticResource Mono}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="1.1*,16,*" ColumnSpacing="0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Railway bucket connection" Style="{StaticResource SectionTitle}" />
                    <Label Text="Credentials stay encrypted for the current Windows user. Downloads run only on demand." Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <VerticalStackLayout><Label Text="Endpoint" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Endpoint}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2"><Label Text="Bucket" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Bucket}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1"><Label Text="Region" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Region}" /></VerticalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Spacing="8" VerticalOptions="Center"><CheckBox IsChecked="{Binding ForcePathStyle}" /><Label Text="Use path-style URLs" VerticalOptions="Center" /></HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="2"><Label Text="Access key ID" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding AccessKeyId}" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="2"><Label Text="Secret access key" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding SecretAccessKey}" IsPassword="True" /></VerticalStackLayout>
                    </Grid>
                    <Button Text="Verify and save connection" Command="{Binding SaveConnectionCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <controls:Card Grid.Column="2" IsInset="True" Title="Conflicts"
                               Subtitle="Different local and remote content is never overwritten silently.">
                    <Grid RowDefinitions="*,Auto" RowSpacing="12">
                        <CollectionView ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" SelectionMode="Single">
                            <CollectionView.EmptyView>
                                <controls:EmptyState Glyph="&#xE73E;" Title="No conflicts" Message="Local and remote copies agree." />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Grid Padding="8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding RelativePath}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding CreatedUtc, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Mono}" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ObjectKey}" Style="{StaticResource Mono}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End"><Button Text="Keep remote" Command="{Binding KeepRemoteCommand}" /><Button Text="Keep local" Command="{Binding KeepLocalCommand}" Style="{StaticResource PrimaryButton}" /></HorizontalStackLayout>
                    </Grid>
                </controls:Card>
            </Grid>
        </Grid>
    </ScrollView>
</ContentView>
