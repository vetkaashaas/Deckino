<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Views.PhotoLibraryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:PhotoLibraryViewModel">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <controls:PageHeader Title="{Binding DisplayName}" Subtitle="{Binding Description}">
            <controls:PageHeader.Actions>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Open photos folder" Command="{Binding OpenPhotosFolderCommand}" Style="{StaticResource QuietButton}" />
                    <Button Text="Refresh library" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <controls:ChipGroup Options="All,Annotated,Unannotated" Selected="{Binding ActiveFilter, Mode=OneWay}"
                                Command="{Binding SetFilterCommand}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Muted}" MaxLines="1"
                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding MatchingCount, StringFormat='{0:N0} matching'}"
                   TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" />
            <Button Grid.Column="3" Text="Select all" Command="{Binding SelectAllMatchingCommand}" Style="{StaticResource QuietButton}" />
        </Grid>

        <!-- A wrapping flow of fixed-width tiles. PhotoLibraryView.xaml.cs picks the column count from the
             available width and sizes the tiles to fill it; a page holds at most 60 photos, so the flow
             does not need virtualising. -->
        <Grid Grid.Row="2">
            <ScrollView x:Name="PhotoScroll">
                <FlexLayout x:Name="PhotoFlow" Wrap="Wrap" Direction="Row" AlignItems="Start" AlignContent="Start" HorizontalOptions="Start"
                            BindableLayout.ItemsSource="{Binding PageItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoLibraryItemViewModel">
                            <!-- The padding is the gap between tiles. -->
                            <Grid Padding="0,0,12,12">
                                <Border Style="{StaticResource Surface}" Padding="8">
                                    <Grid RowDefinitions="170,Auto,Auto,Auto" RowSpacing="4">
                                        <Image Source="{Binding Thumbnail}" Aspect="AspectFit" BackgroundColor="{StaticResource Graphite950}" />
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <Label Text="{Binding FileName}" FontFamily="OpenSansSemibold" MaxLines="1" VerticalOptions="Center" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" />
                                        </Grid>
                                        <Label Grid.Row="2" Text="{Binding RelativePath}" Style="{StaticResource Mono}" MaxLines="1"
                                               LineBreakMode="MiddleTruncation" />
                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label FontSize="11" MaxLines="1">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding AnnotationStatus}" TextColor="{StaticResource Accent}" />
                                                        <Span Text="  ·  " TextColor="{StaticResource DisabledText}" />
                                                        <Span Text="{Binding CaptureCondition}" TextColor="{StaticResource MutedText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding Dimensions}" Style="{StaticResource Mono}" VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
            <controls:EmptyState x:Name="NoPhotos" Glyph="&#xE8B9;" Title="No photos match this filter"
                                 InputTransparent="True" />
        </Grid>

        <!-- Footer: the selection bar appears only while photos are selected; the pager is always there. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="34">
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding SelectedCount, Converter={StaticResource HasValue}}">
                <Label Text="{Binding SelectedCount, StringFormat='{0:N0} selected'}" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                <Button Text="Clear" Command="{Binding ClearSelectionCommand}" Style="{StaticResource QuietButton}" />
                <Button Text="Delete annotations" Command="{Binding DeleteAnnotationsCommand}" Style="{StaticResource DangerButton}" />
                <Button Text="Delete photos + annotations" Command="{Binding DeletePhotosCommand}" Style="{StaticResource DangerButton}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <Button Text="Previous" Command="{Binding PreviousPageCommand}" />
                <Label Text="{Binding PageLabel}" Style="{StaticResource Mono}" VerticalOptions="Center" />
                <Button Text="Next" Command="{Binding NextPageCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>
