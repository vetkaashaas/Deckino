<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Views.SyncView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:SyncViewModel">
    <!-- The page fits the window: the cards scroll in their own column and the log takes the rest of the height. -->
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <controls:PageHeader Title="{Binding DisplayName}" Subtitle="{Binding Description}">
            <controls:PageHeader.Status>
                <controls:StatusPill Text="{Binding FreshnessText}" Tone="{Binding FreshnessTone}" />
            </controls:PageHeader.Status>
            <controls:PageHeader.Actions>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Open image folder" Command="{Binding OpenImageFolderCommand}" Style="{StaticResource QuietButton}" />
                    <Button Text="Retry failed" Command="{Binding RetryFailedCommand}" Style="{StaticResource QuietButton}"
                            IsVisible="{Binding HasFailures}"
                            ToolTipProperties.Text="Download the card images that failed again; their reasons are in the activity log" />
                    <Button Text="Check for updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource QuietButton}"
                            ToolTipProperties.Text="Compare Scryfall's latest bulk files with this computer without downloading anything" />
                    <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                            IsVisible="{Binding IsBusy}" />
                    <Button Text="Sync now" Command="{Binding SyncCommand}" Style="{StaticResource PrimaryButton}"
                            IsVisible="{Binding IsIdle}" />
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Errors stay until dismissed, with the full detail one click away. -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource DangerWash}" Stroke="{StaticResource Danger}"
                StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="16,10"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontFamily="OpenSansSemibold"
                       LineBreakMode="WordWrap" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Copy details" Command="{Binding CopyErrorCommand}" Style="{StaticResource QuietButton}" />
                <Button Grid.Column="2" Text="Dismiss" Command="{Binding DismissErrorCommand}" Style="{StaticResource QuietButton}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Surface}">
            <VerticalStackLayout Spacing="14">
                <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
                    <controls:StatTile Heading="Printings" Value="{Binding Printings}" Caption="one per artwork" WidthRequest="150" Margin="0,0,12,8" />
                    <controls:StatTile Heading="Oracle cards" Value="{Binding OracleCards}" Caption="unique cards" WidthRequest="150" Margin="0,0,12,8" />
                    <controls:StatTile Heading="Sets" Value="{Binding Sets}" Caption="in the catalogue" WidthRequest="150" Margin="0,0,12,8" />
                    <controls:StatTile Heading="Card images" Value="{Binding ImagesCached}" Caption="{Binding ImagesCaption}" WidthRequest="180" Margin="0,0,12,8" />
                    <controls:StatTile Heading="Failed" Value="{Binding ImagesFailed}" Caption="kept until retried" WidthRequest="150" Margin="0,0,12,8" />
                    <controls:StatTile Heading="Disk used" Value="{Binding DiskUsed}" Caption="card-images folder" WidthRequest="150" Margin="0,0,12,8" />
                </FlexLayout>
                <ProgressBar Progress="{Binding ImagesPercent, Converter={StaticResource PercentToProgress}}" />
                <Label Text="{Binding Status}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Border>

        <!-- The pipeline scrolls in its own column (narrowed by SyncView.xaml.cs when tight); the log takes the rest. -->
        <Grid x:Name="Body" Grid.Row="3" ColumnDefinitions="460,*" ColumnSpacing="16">
            <ScrollView>
                <controls:Card Title="Pipeline" Subtitle="{Binding LastRunText}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stages}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SyncStageViewModel">
                                <Grid Padding="0,9" ColumnDefinitions="10,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="10" RowSpacing="3">
                                    <Ellipse WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                                             Fill="{Binding Status, Converter={StaticResource StageColor}}" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource Mono}" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                           Style="{StaticResource Muted}" />
                                    <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                                 Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}"
                                                 IsVisible="{Binding ShowsProgress}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </controls:Card>
            </ScrollView>

            <controls:LogPanel Grid.Column="1" Status="{Binding Status}"
                               ItemsSource="{Binding LiveLog}" SelectedItem="{Binding SelectedLogLine}"
                               OpenFolderCommand="{Binding OpenLogFolderCommand}" ClearCommand="{Binding ClearLogCommand}"
                               CopySelectedCommand="{Binding CopySelectedLogCommand}" CopyAllCommand="{Binding CopyAllLogsCommand}" />
        </Grid>
    </Grid>
</ContentView>
