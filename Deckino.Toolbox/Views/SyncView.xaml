<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Views.SyncView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:SyncViewModel">
    <ScrollView>
        <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
            <controls:PageHeader Title="{Binding DisplayName}" Subtitle="{Binding Description}">
                <controls:PageHeader.Status>
                    <controls:StatusPill Text="{Binding Kind, StringFormat='{0}'}" Tone="{Binding Kind, Converter={StaticResource StatusKindTone}}" />
                </controls:PageHeader.Status>
                <controls:PageHeader.Actions>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Open art cache" Command="{Binding OpenArtFolderCommand}" Style="{StaticResource QuietButton}" />
                        <Button Text="Cancel" Command="{Binding CancelCommand}" />
                        <Button Text="Sync all data" Command="{Binding SyncCommand}" Style="{StaticResource PrimaryButton}" />
                    </HorizontalStackLayout>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border Grid.Row="1" Style="{StaticResource Surface}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="14" RowSpacing="12">
                    <Ellipse WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                             Fill="{Binding Kind, Converter={StaticResource StatusKindColor}}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Current run" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding StatusLine}" FontFamily="OpenSansSemibold" FontSize="18" />
                        <Label Text="{Binding StatusDetail}" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                 Progress="{Binding BulkProgressPercent, Converter={StaticResource PercentToProgress}}" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ErrorDetail}" TextColor="{StaticResource Danger}"
                           LineBreakMode="WordWrap" MaxLines="6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopyErrorCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,1,*,1,*,1,*" ColumnSpacing="16">
                <controls:StatTile Heading="Cards" Value="{Binding CardsInDb, StringFormat='{0:N0}'}" Caption="in SQLite" />
                <BoxView Grid.Column="1" Color="{StaticResource Graphite700}" WidthRequest="1" />
                <controls:StatTile Grid.Column="2" Heading="Oracle cards" Value="{Binding OracleCardsInDb, StringFormat='{0:N0}'}" Caption="unique identities" />
                <BoxView Grid.Column="3" Color="{StaticResource Graphite700}" WidthRequest="1" />
                <controls:StatTile Grid.Column="4" Heading="Art cached" Value="{Binding ImagesDone, StringFormat='{0:N0}'}" Caption="ready locally" />
                <BoxView Grid.Column="5" Color="{StaticResource Graphite700}" WidthRequest="1" />
                <controls:StatTile Grid.Column="6" Heading="Art pending" Value="{Binding ImagesPending, StringFormat='{0:N0}'}" Caption="{Binding ImagesFailed, StringFormat='failed {0:N0}'}" />
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource InsetSurface}" VerticalOptions="Start">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Local cache coverage" Style="{StaticResource SectionTitle}" /><Label Grid.Column="1" Text="{Binding CacheProgressPercent, StringFormat='{0:0.0}%'}" TextColor="{StaticResource Accent}" /></Grid>
                    <ProgressBar Progress="{Binding CacheProgressPercent, Converter={StaticResource PercentToProgress}}" />
                    <Label Text="Scryfall → SQLite → local artwork → training" Style="{StaticResource Mono}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentView>
