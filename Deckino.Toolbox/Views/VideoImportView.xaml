<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="Deckino.Toolbox.Views.VideoImportView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Deckino.Toolbox.Controls"
    xmlns:vm="clr-namespace:Deckino.Toolbox.ViewModels"
    x:DataType="vm:VideoImportViewModel">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,*" RowSpacing="16">
        <controls:PageHeader Title="{Binding DisplayName}" Subtitle="{Binding Description}">
            <controls:PageHeader.Actions>
                <Button Text="Select video" Command="{Binding PickVideoCommand}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Left: what goes in and how densely it is sampled. Right: what comes out. -->
        <Grid x:Name="Columns" Grid.Row="1" ColumnDefinitions="400,*" ColumnSpacing="16">
            <ScrollView VerticalScrollBarVisibility="Default">
                <VerticalStackLayout Spacing="16">
                    <controls:Card Title="Source">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding SelectedVideoName}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding SelectedVideoPath}" Style="{StaticResource Mono}" LineBreakMode="MiddleTruncation"
                                   ToolTipProperties.Text="{Binding SelectedVideoPath}"
                                   IsVisible="{Binding SelectedVideoPath, Converter={StaticResource HasValue}}" />
                            <Label Text="{Binding VideoDetails}" Style="{StaticResource Mono}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding RuntimeStatus}" Style="{StaticResource Muted}"
                                   IsVisible="{Binding RuntimeStatus, Converter={StaticResource HasValue}}" />
                        </VerticalStackLayout>
                    </controls:Card>

                    <controls:Card Title="Frame density">
                        <CollectionView ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}"
                                        SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:VideoPresetOption">
                                    <Grid Padding="12,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding FramesPerSecond, StringFormat='{0} fps'}" TextColor="{StaticResource Accent}" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentWash}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </controls:Card>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Column="1" Spacing="16">
                <controls:Card Title="Estimated output">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding EstimateLabel}" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" />
                        <Label Text="Every sampled frame is retained, including blur and difficult lighting." Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </controls:Card>

                <!-- Progress and the actions that drive it sit together. -->
                <controls:Card Title="Import progress">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ProgressLabel}" FontFamily="OpenSansSemibold" />
                        <ProgressBar Progress="{Binding ProgressPercent, Converter={StaticResource PercentToProgress}}" />
                        <Label Text="{Binding Status}" Style="{StaticResource Muted}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                            <Button Text="Open batch folder" Command="{Binding OpenBatchCommand}" Style="{StaticResource QuietButton}" />
                            <Button Grid.Column="2" Text="Cancel" Command="{Binding CancelCommand}" />
                            <Button Grid.Column="3" Text="Extract frames" Command="{Binding ExtractCommand}" IsEnabled="{Binding CanConfigure}" Style="{StaticResource PrimaryButton}" />
                        </Grid>
                    </VerticalStackLayout>
                </controls:Card>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>
