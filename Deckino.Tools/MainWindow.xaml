<Window x:Class="Deckino.Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Deckino.Tools.ViewModels"
        xmlns:views="clr-namespace:Deckino.Tools.Views"
        mc:Ignorable="d"
        Title="Deckino Tools"
        Height="820"
        Width="1360"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Base}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Text.Primary}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnnotatorViewModel}">
            <views:AnnotatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhotoLibraryViewModel}">
            <views:PhotoLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtractionTrainingViewModel}">
            <views:ExtractionTrainingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunnerViewModel}">
            <views:RunnerView />
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceNavTemplate">
            <Grid MinHeight="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30"
                        Height="30"
                        Background="{StaticResource Bg.PanelRaised}"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <Path x:Name="NavIcon"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Fill="{StaticResource Text.Secondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M4 4h16v16H4z" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="NavDescription"
                               Text="Workspace"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DisplayName}" Value="Scryfall Sync">
                    <Setter TargetName="NavIcon" Property="Data" Value="M3 5h18v14H3V5zm2 2v10h14V7H5zm2 2h4v2H7V9zm0 4h10v2H7v-2z" />
                    <Setter TargetName="NavDescription" Property="Text" Value="Card data &amp; art cache" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayName}" Value="Corner Annotator">
                    <Setter TargetName="NavIcon" Property="Data" Value="M4 4h6v2H6v4H4V4zm10 0h6v6h-2V6h-4V4zM4 14h2v4h4v2H4v-6zm14 0h2v6h-6v-2h4v-4z" />
                    <Setter TargetName="NavDescription" Property="Text" Value="Corner data preparation" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayName}" Value="Photo Library">
                    <Setter TargetName="NavIcon" Property="Data" Value="M3 4h18v16H3V4zm2 2v12h14V6H5zm2 2h4v4H7V8zm6 0h4v4h-4V8zM7 14h4v2H7v-2zm6 0h4v2h-4v-2z" />
                    <Setter TargetName="NavDescription" Property="Text" Value="Imported camera photos" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayName}" Value="Card Extraction">
                    <Setter TargetName="NavIcon" Property="Data" Value="M4 3h5v2H6v3H4V3zm11 0h5v5h-2V5h-3V3zM4 16h2v3h3v2H4v-5zm14 0h2v5h-5v-2h3v-3zM8 8h8v8H8V8zm2 2v4h4v-4h-4z" />
                    <Setter TargetName="NavDescription" Property="Text" Value="Four-corner model" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayName}" Value="Model Training">
                    <Setter TargetName="NavIcon" Property="Data" Value="M12 3a9 9 0 1 0 9 9h-2a7 7 0 1 1-7-7V3zm2 0v7h7v2h-9V3h2z" />
                    <Setter TargetName="NavDescription" Property="Text" Value="CUDA training pipeline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Bg.Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,24,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            Background="{StaticResource Accent}"
                            CornerRadius="10">
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Fill="#07111F"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M4 5h16v14H4V5zm2 2v10h12V7H6zm2 2h8v2H8V9zm0 4h5v2H8v-2z" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DECKINO" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="TOOLS" Margin="0,1,0,0" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACES" Margin="24,0,0,8" Style="{StaticResource EyebrowText}" />
                    <ListBox ItemsSource="{Binding Workspaces}"
                             SelectedItem="{Binding CurrentPage}"
                             Style="{StaticResource NavList}"
                             ItemTemplate="{StaticResource WorkspaceNavTemplate}" />
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="24,18,24,22">
                    <StackPanel>
                        <TextBlock Text="LOCAL WORKSPACE" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Tools for data, training, and evaluation"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource Border.Subtle}" />

        <Border Grid.Column="2" Background="{StaticResource Bg.Base}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
