<UserControl x:Class="Deckino.Tools.Views.AnnotatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="AnnotatorView_PreviewKeyDown">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DATA PREPARATION" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource PageDescription}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Refresh queue" Command="{Binding RefreshCommand}" Style="{StaticResource CompactButton}" Margin="0,0,10,0" />
                <Button Content="Import folders" Command="{Binding ImportFoldersCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14,10" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource Text.Muted}" />
                    <TextBlock Text="{Binding CurrentRelativePath}" Foreground="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{StaticResource Accent.Hover}">
                    <Run Text="Pending " /><Run Text="{Binding QueueCount, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource InsetPanel}" Padding="0" ClipToBounds="True">
                <Canvas x:Name="PhotoViewport"
                        Background="{StaticResource Bg.Inset}"
                        ClipToBounds="True"
                        Focusable="True"
                        SizeChanged="PhotoViewport_SizeChanged"
                        MouseWheel="PhotoViewport_MouseWheel"
                        MouseLeftButtonDown="PhotoViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="PhotoViewport_MouseLeftButtonUp"
                        MouseRightButtonDown="PhotoViewport_MouseRightButtonDown"
                        MouseRightButtonUp="PhotoViewport_MouseRightButtonUp"
                        MouseMove="PhotoViewport_MouseMove">
                    <Image x:Name="PhotoImage" Source="{Binding CurrentImage}" Stretch="Fill" IsHitTestVisible="False" />
                    <TextBlock x:Name="EmptyMessage" Text="No unannotated photos in the queue"
                               Foreground="{StaticResource Text.Muted}" FontSize="16"
                               Canvas.Left="30" Canvas.Top="30" IsHitTestVisible="False" />
                </Canvas>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Panel}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CORNER ORDER" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding NextCornerName}" Style="{StaticResource SectionTitle}" Margin="0,5,0,0" />
                        <TextBlock Text="TopLeft → TopRight → BottomRight → BottomLeft"
                                   Foreground="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
                            <Button Content="Clear points" Command="{Binding ClearPointsCommand}" Style="{StaticResource CompactButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14" Margin="0,12,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="PERSPECTIVE PREVIEW" Style="{StaticResource EyebrowText}" />
                        <Border Grid.Row="1" Background="{StaticResource Bg.Inset}" Margin="0,10,0,10" CornerRadius="7" ClipToBounds="True">
                            <Image Source="{Binding PerspectivePreview}" Stretch="Uniform" Margin="8" />
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding GeometryStatus}" Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <Button Content="Save &amp; next" Command="{Binding SaveNextCommand}" Style="{StaticResource PrimaryButton}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="Skip" Command="{Binding SkipCommand}" Style="{StaticResource CompactButton}" />
                        <Button Grid.Column="2" Content="No card &amp; next" Command="{Binding MarkNoCardNextCommand}" Style="{StaticResource CompactButton}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Bg.PanelRaised}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
