<UserControl x:Class="Deckino.Tools.Views.AnnotatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,32,36,40" MaxWidth="980" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="DATA PREPARATION" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource PageDescription}"
                           Margin="0,9,0,0"
                           MaxWidth="760" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,30,0,0" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="154"
                            Height="154"
                            Background="{StaticResource Bg.Inset}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="18"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <Grid Margin="26">
                            <Border BorderBrush="{StaticResource Accent}"
                                    BorderThickness="2"
                                    Opacity="0.8" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <Path Width="46"
                                  Height="46"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource Text.Muted}"
                                  StrokeThickness="1.5"
                                  Data="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="{StaticResource Accent.Subtle}"
                                CornerRadius="14"
                                Padding="11,6"
                                HorizontalAlignment="Left">
                            <TextBlock Text="WORKSPACE IN PREPARATION"
                                       Foreground="{StaticResource Accent.Hover}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="Corner-aware annotation is the next step"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="This surface will review imported labels and real-camera examples before they enter the training pipeline."
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Margin="0,9,0,0"
                                   MaxWidth="600" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="22">
                <StackPanel>
                    <TextBlock Text="PLANNED WORKFLOW" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="A focused review loop for four-corner data"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,5,0,0" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="32" Height="32" Background="{StaticResource Bg.Selected}" CornerRadius="10">
                            <TextBlock Text="01" Foreground="{StaticResource Accent.Hover}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Import and inspect" FontWeight="SemiBold" />
                            <TextBlock Text="Bring in existing labels and surface difficult examples."
                                       Foreground="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="4" Width="32" Height="32" Background="{StaticResource Bg.Selected}" CornerRadius="10">
                            <TextBlock Text="02" Foreground="{StaticResource Accent.Hover}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Validate the warp" FontWeight="SemiBold" />
                            <TextBlock Text="Review ordered corners, perspective correction, and validation failures."
                                       Foreground="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
