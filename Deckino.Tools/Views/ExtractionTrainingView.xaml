<UserControl x:Class="Deckino.Tools.Views.ExtractionTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,40" MaxWidth="1040" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="LOCALIZATION MODEL" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource PageDescription}"
                           Margin="0,9,0,0"
                           MaxWidth="790" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TRAINING PIPELINE" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Six gated stages" Style="{StaticResource SectionTitle}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource Warning.Subtle}"
                                    CornerRadius="14"
                                    Padding="11,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="SETUP PENDING"
                                           Foreground="{StaticResource Warning}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stages}" Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30"
                                                    Background="{StaticResource Bg.Selected}"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Number}"
                                                           Foreground="{StaticResource Accent.Hover}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Margin="0,3,12,0"
                                                           Foreground="{StaticResource Text.Muted}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding State}"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Panel}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="MODEL CONTRACT" Style="{StaticResource EyebrowText}" />
                            <Grid Margin="0,18,0,0" Height="180">
                                <Border Width="124"
                                        Height="172"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource Bg.Inset}"
                                        BorderBrush="{StaticResource Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid Margin="12">
                                        <Polygon Points="5,14 90,5 98,139 0,148"
                                                 Stroke="{StaticResource Accent}"
                                                 StrokeThickness="2"
                                                 Fill="Transparent" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}"
                                                 Margin="1,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}"
                                                 Margin="0,1,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}"
                                                 Margin="0,0,0,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}"
                                                 Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Text="192 px input · 4 ordered corners · presence confidence"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="ARTIFACT VERSIONS" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Dataset" Margin="0,14,0,4" Foreground="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text="{Binding DatasetVersion}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                            <TextBlock Text="Model" Margin="0,12,0,4" Foreground="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text="{Binding ModelVersion}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="18,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Margin="11,0,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
