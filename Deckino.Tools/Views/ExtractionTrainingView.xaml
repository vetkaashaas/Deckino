<UserControl x:Class="Deckino.Tools.Views.ExtractionTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Deckino.Tools.Services"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,40" MaxWidth="1180" HorizontalAlignment="Left">
            <TextBlock Text="LOCALIZATION MODEL" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource PageDescription}"
                       Margin="0,9,0,0" MaxWidth="900" />

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}" Padding="24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRODUCTION WORKFLOW" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Train from the latest annotations" Style="{StaticResource SectionTitle}" Margin="0,5,0,0" />
                                <TextBlock Text="An unfinished run with the same synthetic setting resumes. Otherwise this reads every annotation currently in Imports and starts a fresh model automatically."
                                           Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource Accent.Subtle}"
                                    CornerRadius="14" Padding="11,6" VerticalAlignment="Center">
                                <TextBlock Text="256 PX · SPATIAL" Foreground="{StaticResource Accent.Hover}"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <CheckBox Content="Include synthetic cards" Margin="0,16,0,0"
                                  Foreground="{StaticResource Text.Primary}"
                                  IsChecked="{Binding IncludeSyntheticCards, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChangeTrainingOptions}" />
                        <TextBlock Text="Off: use annotated imports only, including No Card photos. On: also cache full-card images and generate synthetic scenes. Changing this setting starts a fresh model."
                                   Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource Text.Muted}" />

                        <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="240" />
                                </Grid.RowDefinitions>
                                <Grid Margin="18,15,18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ACTIVITY LOG" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open logs" Command="{Binding OpenLogFolderCommand}"
                                            Style="{StaticResource CompactButton}" Margin="10,0,0,0" />
                                    <Button Grid.Column="2" Content="Clear all" Command="{Binding ClearAllLogsCommand}"
                                            Style="{StaticResource CompactButton}" Margin="7,0,0,0" />
                                    <Button Grid.Column="3" Content="Copy selected" Command="{Binding CopySelectedLogCommand}"
                                            Style="{StaticResource CompactButton}" Margin="7,0,0,0" />
                                    <Button Grid.Column="4" Content="Copy all" Command="{Binding CopyAllLogsCommand}"
                                            Style="{StaticResource CompactButton}" Margin="7,0,0,0" />
                                </Grid>
                                <ListBox x:Name="ActivityLogList" Grid.Row="1"
                                         ItemsSource="{Binding LiveLog}"
                                         SelectedItem="{Binding SelectedLogLine, Mode=TwoWay}"
                                         Style="{StaticResource LogList}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Stages}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" Background="{StaticResource Bg.Selected}" CornerRadius="7">
                                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource Accent.Hover}"
                                                           FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,14,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Text.Muted}" FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Passed}">
                                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Warning}">
                                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Failed}">
                                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Running}">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Train latest card extractor" Command="{Binding RunFullCommand}"
                                    Style="{StaticResource PrimaryButton}" MinWidth="220" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Style="{StaticResource CompactButton}" Margin="9,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Panel}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="READINESS" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{Binding GpuSummary}" Margin="0,13,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding AssetSummary}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text.Muted}" FontSize="12" />
                            <TextBlock Text="Full-card assets are only needed when Include synthetic cards is checked."
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text.Muted}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="22" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="SIMPLE RUN BEHAVIOR" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Click once to use the latest annotated imports. An interrupted run resumes when the synthetic setting matches. Changing the setting or finishing a run makes the next click start a fresh model."
                                       Margin="0,13,0,0" Foreground="{StaticResource Text.Secondary}"
                                       FontSize="12" TextWrapping="Wrap" />
                            <Button Content="Open extraction folder" Command="{Binding OpenExtractionFolderCommand}"
                                    Style="{StaticResource CompactButton}" Margin="0,14,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="22">
                <StackPanel>
                    <TextBlock Text="RECTIFICATION DIAGNOSTIC" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Run the trained extractor on an owned local photograph. This does not invoke identity recognition."
                               Margin="0,6,0,0" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DiagnosticImagePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Choose image" Command="{Binding PickDiagnosticImageCommand}"
                                Style="{StaticResource CompactButton}" Margin="9,0,0,0" />
                        <Button Grid.Column="2" Content="Rectify preview" Command="{Binding RunDiagnosticCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding DiagnosticOutputPath}" Margin="0,8,0,0"
                               Foreground="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DiagnosticSummary}" Margin="0,6,0,0"
                               Foreground="{StaticResource Accent.Hover}" FontWeight="SemiBold" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PREDICTION + GROUND TRUTH" Style="{StaticResource EyebrowText}" Margin="0,0,0,7" />
                            <Border Background="{StaticResource Bg.Inset}" CornerRadius="8" Padding="6" MinHeight="180">
                                <Image Source="{Binding DiagnosticOverlayPreview}" Stretch="Uniform" MaxHeight="300" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="315 × 440 + IDENTITY CROP" Style="{StaticResource EyebrowText}" Margin="0,0,0,7" />
                            <Border Background="{StaticResource Bg.Inset}" CornerRadius="8" Padding="6" MinHeight="180">
                                <Grid>
                                    <TextBlock Text="{Binding DiagnosticCropStatus}" Foreground="{StaticResource Text.Muted}"
                                               TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12" />
                                    <Image Source="{Binding RectifiedPreview}" Stretch="Uniform" MaxHeight="300" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="224 × 224 INSPECTION CROP" Style="{StaticResource EyebrowText}" Margin="0,0,0,7" />
                            <Border Background="{StaticResource Bg.Inset}" CornerRadius="8" Padding="6" MinHeight="180">
                                <Grid>
                                    <TextBlock Text="{Binding DiagnosticCropStatus}" Foreground="{StaticResource Text.Muted}"
                                               TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12" />
                                    <Image Source="{Binding RecognitionCropPreview}" Stretch="Uniform" MaxHeight="224" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
