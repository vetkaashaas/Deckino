<UserControl x:Class="Deckino.Tools.Views.RunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Deckino.Tools.ViewModels"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,32" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{Binding DisplayName}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" Margin="0,7,0,0"
                       Foreground="{StaticResource Text.Muted}" FontSize="14" TextWrapping="Wrap" />

            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="12" Margin="0,20,0,0" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="20,18,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1–2 · CUDA environment" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Text="{Binding RequirementsCaption}" Margin="0,5,0,0"
                                       Foreground="{StaticResource Text.Muted}" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,6" CornerRadius="14"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Bg.Hover}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnvironmentReady}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Success.Subtle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RequirementsHeadline}" FontWeight="SemiBold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EnvironmentReady}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RequirementChecks}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRequirementDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RequirementCheckItem}">
                                <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                                        Padding="20,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="StatusMark" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Bg.Hover}" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="StatusGlyph" Text="·" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   Foreground="{StaticResource Text.Muted}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RequirementState.Passed}">
                                        <Setter TargetName="StatusMark" Property="Background" Value="{StaticResource Success.Subtle}" />
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="✓" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RequirementState.Warning}">
                                        <Setter TargetName="StatusMark" Property="Background" Value="{StaticResource Warning.Subtle}" />
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="!" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RequirementState.Missing}">
                                        <Setter TargetName="StatusMark" Property="Background" Value="{StaticResource Danger.Subtle}" />
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="×" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                            Background="#18181C" Padding="20,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check requirements" Command="{Binding CheckRequirementsCommand}" MinWidth="150" />
                            <Button Content="Install required packages" Command="{Binding InstallPackagesCommand}"
                                    Margin="8,0,0,0" MinWidth="180" Background="{StaticResource Accent}"
                                    BorderBrush="{StaticResource Accent}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="3–4  Dataset and CUDA smoke" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Dataset version" Margin="0,10,0,4" Foreground="{StaticResource Text.Muted}" />
                        <TextBox Text="{Binding DatasetVersion, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Prepare dataset" Command="{Binding PrepareDatasetCommand}"
                                    IsEnabled="{Binding CanPrepareDataset}" />
                            <Button Content="Run CUDA smoke" Command="{Binding RunCudaSmokeCommand}"
                                    IsEnabled="{Binding DatasetReady}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="5  Train or resume" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Model version" Margin="0,10,0,4" Foreground="{StaticResource Text.Muted}" />
                        <TextBox Text="{Binding ModelVersion, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="CUDA · AMP · batch 64 · 20 epochs · 4 workers · 512d · 3e-4"
                                   Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        <Button Content="Train / resume" Command="{Binding TrainCommand}" IsEnabled="{Binding CudaSmokeReady}"
                                Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="130" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="6–7  Camera validation and evaluation" FontWeight="SemiBold" FontSize="16" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CameraVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding CameraCaptureFolder}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Choose folder" Command="{Binding PickCameraFolderCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Prepare camera set" Command="{Binding PrepareCameraCommand}" IsEnabled="{Binding TrainingReady}" />
                        <Button Content="Evaluate" Command="{Binding EvaluateCommand}" IsEnabled="{Binding TrainingReady}"
                                Margin="8,0,0,0" MinWidth="100" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="8–9  Recognize and export" FontWeight="SemiBold" FontSize="16" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RecognitionImage}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Choose image" Command="{Binding PickRecognitionImageCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Recognize" Command="{Binding RecognizeCommand}" IsEnabled="{Binding EvaluationReady}" />
                        <Button Content="Export result ZIP" Command="{Binding ExportResultsCommand}" IsEnabled="{Binding EvaluationReady}"
                                Margin="8,0,0,0" />
                        <Button Content="Open training folder" Command="{Binding OpenTrainingFolderCommand}" Margin="8,0,0,0" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding Status}" Margin="0,5,0,0" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy selected" Command="{Binding CopySelectedLogCommand}"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Copy all" Command="{Binding CopyAllLogsCommand}"
                                Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox ItemsSource="{Binding LiveLog}"
                             SelectedItem="{Binding SelectedLogLine, Mode=TwoWay}"
                             Height="230" Padding="4" FontFamily="Consolas" FontSize="11"
                             Background="#0D1016" Foreground="{StaticResource Text.Muted}"
                             BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
