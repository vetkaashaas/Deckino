<UserControl x:Class="Deckino.Tools.Views.RunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Deckino.Tools.ViewModels"
             xmlns:services="clr-namespace:Deckino.Tools.Services"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,40" MaxWidth="1180" HorizontalAlignment="Left">
            <TextBlock Text="MODEL WORKSPACE" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource PageDescription}"
                       Margin="0,9,0,0"
                       MaxWidth="900" />

            <Border Style="{StaticResource Panel}" Margin="0,28,0,0" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="22,20,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                Background="{StaticResource Accent.Subtle}"
                                CornerRadius="12">
                            <Path Width="18"
                                  Height="18"
                                  Stretch="Uniform"
                                  Fill="{StaticResource Accent}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M12 3a9 9 0 1 0 9 9h-2a7 7 0 1 1-7-7V3zm2 0v7h7v2h-9V3h2z" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,20,0">
                            <TextBlock Text="01—02  ENVIRONMENT READINESS" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Prepare the local CUDA workspace"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="{Binding RequirementsCaption}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Padding="12,7"
                                CornerRadius="15"
                                VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Warning.Subtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnvironmentReady}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Success.Subtle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RequirementsHeadline}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EnvironmentReady}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource Bg.PanelRaised}"
                            Padding="22,16">
                        <WrapPanel>
                            <Button Content="Check requirements"
                                    Command="{Binding CheckRequirementsCommand}"
                                    Style="{StaticResource CompactButton}"
                                    MinWidth="154" />
                            <Button Content="Install required packages"
                                    Command="{Binding InstallPackagesCommand}"
                                    IsEnabled="{Binding CanInstallPackages}"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="The pinned Python and CUDA packages are already installed when this button is disabled."
                                    ToolTipService.ShowOnDisabled="True"
                                    Margin="9,0,0,0"
                                    MinWidth="190"
                                    MinHeight="34"
                                    Padding="14,0" />
                            <ToggleButton IsChecked="{Binding ShowRequirementDetails, Mode=TwoWay}"
                                          Style="{StaticResource ExpandToggle}"
                                          ToolTip="Show or hide the detailed requirement checklist"
                                          Margin="9,0,0,0" />
                        </WrapPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding RequirementChecks}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRequirementDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RequirementCheckItem}">
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,1,0,0"
                                        Padding="22,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="StatusMark"
                                                Width="23"
                                                Height="23"
                                                CornerRadius="12"
                                                Background="{StaticResource Bg.Hover}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="StatusGlyph"
                                                       Text="·"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RequirementState.Passed}">
                                        <Setter TargetName="StatusMark" Property="Background" Value="{StaticResource Success.Subtle}" />
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="✓" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RequirementState.Warning}">
                                        <Setter TargetName="StatusMark" Property="Background" Value="{StaticResource Warning.Subtle}" />
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="!" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RequirementState.Missing}">
                                        <Setter TargetName="StatusMark" Property="Background" Value="{StaticResource Danger.Subtle}" />
                                        <Setter TargetName="StatusGlyph" Property="Text" Value="×" />
                                        <Setter TargetName="StatusGlyph" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,20,0,0" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="24,22,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Background="{StaticResource Accent.Subtle}" CornerRadius="14">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Accent}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M4 4h16v3H4V4zm0 6h16v3H4v-3zm0 6h10v3H4v-3z" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,24,0">
                            <TextBlock Text="ARTWORK RETRIEVAL WORKFLOW" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Qualify the artwork recognizer"
                                       Style="{StaticResource SectionTitle}" Margin="0,5,0,0" />
                            <TextBlock Text="One resumable run builds artwork prototypes, measures the existing model, retrains only if needed, qualifies, exports, and verifies."
                                       Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="12,7" CornerRadius="15" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Accent.Subtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProductionOutcome}" Value="{x:Static services:ProductionWorkflowOutcome.Passed}">
                                            <Setter Property="Background" Value="{StaticResource Success.Subtle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ProductionOutcome}" Value="{x:Static services:ProductionWorkflowOutcome.Warning}">
                                            <Setter Property="Background" Value="{StaticResource Warning.Subtle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ProductionOutcome}" Value="{x:Static services:ProductionWorkflowOutcome.Failed}">
                                            <Setter Property="Background" Value="{StaticResource Danger.Subtle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ProductionSummary}" FontSize="11" FontWeight="SemiBold"
                                       MaxWidth="330" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProductionOutcome}" Value="{x:Static services:ProductionWorkflowOutcome.Passed}">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProductionOutcome}" Value="{x:Static services:ProductionWorkflowOutcome.Warning}">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProductionOutcome}" Value="{x:Static services:ProductionWorkflowOutcome.Failed}">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ProductionStages}" Margin="20,0,20,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:ProductionStageResult}">
                                <Border x:Name="StageCard" Background="{StaticResource Bg.PanelRaised}"
                                        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                                        CornerRadius="10" Margin="4" Padding="12,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="StageMark" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Bg.Hover}" VerticalAlignment="Top">
                                            <TextBlock x:Name="StageGlyph" Text="·" Foreground="{StaticResource Text.Muted}"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Text.Muted}"
                                                       FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Running}">
                                        <Setter TargetName="StageMark" Property="Background" Value="{StaticResource Accent.Subtle}" />
                                        <Setter TargetName="StageGlyph" Property="Text" Value="→" />
                                        <Setter TargetName="StageGlyph" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="StageCard" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Passed}">
                                        <Setter TargetName="StageMark" Property="Background" Value="{StaticResource Success.Subtle}" />
                                        <Setter TargetName="StageGlyph" Property="Text" Value="✓" />
                                        <Setter TargetName="StageGlyph" Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Warning}">
                                        <Setter TargetName="StageMark" Property="Background" Value="{StaticResource Warning.Subtle}" />
                                        <Setter TargetName="StageGlyph" Property="Text" Value="!" />
                                        <Setter TargetName="StageGlyph" Property="Foreground" Value="{StaticResource Warning}" />
                                        <Setter TargetName="StageCard" Property="BorderBrush" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Failed}">
                                        <Setter TargetName="StageMark" Property="Background" Value="{StaticResource Danger.Subtle}" />
                                        <Setter TargetName="StageGlyph" Property="Text" Value="×" />
                                        <Setter TargetName="StageGlyph" Property="Foreground" Value="{StaticResource Danger}" />
                                        <Setter TargetName="StageCard" Property="BorderBrush" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:ProductionStageStatus.Cancelled}">
                                        <Setter TargetName="StageMark" Property="Background" Value="{StaticResource Warning.Subtle}" />
                                        <Setter TargetName="StageGlyph" Property="Text" Value="Ⅱ" />
                                        <Setter TargetName="StageGlyph" Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                            Background="{StaticResource Bg.PanelRaised}" Padding="22,15">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Run / resume artwork workflow" Command="{Binding RunProductionCommand}"
                                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanRunProduction}"
                                        ToolTip="{Binding ProductionActionHint}"
                                        ToolTipService.ShowOnDisabled="True"
                                        MinWidth="206" MinHeight="38" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}"
                                        Style="{StaticResource DangerButton}" Margin="9,0,0,0" MinHeight="38" />
                                <Button Content="Start new model version" Command="{Binding StartNewModelVersionCommand}"
                                        Style="{StaticResource CompactButton}" IsEnabled="{Binding CanStartNewModelVersion}"
                                        Margin="9,0,0,0" MinHeight="38" />
                                <ToggleButton IsChecked="{Binding ShowRunDetails, Mode=TwoWay}"
                                              Style="{StaticResource ExpandToggle}"
                                              ToolTip="Show or hide fixed run details" Margin="9,0,0,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ProductionActionHint}"
                                       Foreground="{StaticResource Warning}"
                                       FontSize="12"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProductionActionHint}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ProductionRunDetails}"
                                       TextWrapping="Wrap" Margin="0,13,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowRunDetails}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="03—04  DATASET &amp; CUDA" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Build and validate the dataset"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="Prepare the versioned export, then verify GPU access before training."
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="DATASET VERSION" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <TextBox Text="{Binding DatasetVersion, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Prepare dataset"
                                    Command="{Binding PrepareDatasetCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanPrepareDataset}"
                                    MinHeight="36" />
                            <Button Content="Run CUDA smoke"
                                    Command="{Binding RunCudaSmokeCommand}"
                                    Style="{StaticResource CompactButton}"
                                    IsEnabled="{Binding DatasetReady}"
                                    Margin="9,0,0,0"
                                    MinHeight="36" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="05  TRAIN OR RESUME" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Generate a new model checkpoint"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="Training resumes from the best available checkpoint for this model version."
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="MODEL VERSION" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <TextBox Text="{Binding ModelVersion, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="CUDA  •  AMP  •  batch 64  •  20 epochs  •  4 workers  •  512d  •  3e-4"
                                   Style="{StaticResource MonoText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Train / resume"
                                    Command="{Binding TrainCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanTrainProduction}"
                                    MinWidth="132"
                                    MinHeight="36" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="06—07  CAMERA VALIDATION &amp; EVALUATION" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Test the model against camera captures"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,5,0,0" />
                    <TextBlock Text="Prepare the real-camera split and evaluate model quality before recognition."
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CAMERA VERSION" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CameraVersion, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CAPTURE FOLDER" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CameraCaptureFolder}" IsReadOnly="True" />
                        </StackPanel>
                        <Button Grid.Column="4"
                                Content="Choose folder"
                                Command="{Binding PickCameraFolderCommand}"
                                Style="{StaticResource CompactButton}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Prepare camera set"
                                Command="{Binding PrepareCameraCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding TrainingReady}"
                                MinHeight="36" />
                        <Button Content="Evaluate"
                                Command="{Binding EvaluateCommand}"
                                Style="{StaticResource CompactButton}"
                                IsEnabled="{Binding TrainingReady}"
                                Margin="9,0,0,0"
                                MinWidth="94"
                                MinHeight="36" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="08—09  RECOGNITION &amp; EXPORT" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Turn evaluation into a portable result"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,5,0,0" />
                    <TextBlock Text="Choose an image to recognize, export the result bundle, or open the working folder."
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECOGNITION IMAGE" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding RecognitionImage}" IsReadOnly="True" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Choose image"
                                Command="{Binding PickRecognitionImageCommand}"
                                Style="{StaticResource CompactButton}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Recognize"
                                Command="{Binding RecognizeCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding EvaluationReady}"
                                MinWidth="104"
                                MinHeight="36" />
                        <Button Content="Export result ZIP"
                                Command="{Binding ExportResultsCommand}"
                                Style="{StaticResource CompactButton}"
                                IsEnabled="{Binding EvaluationReady}"
                                Margin="9,0,0,0"
                                MinHeight="36" />
                        <Button Content="Open training folder"
                                Command="{Binding OpenTrainingFolderCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="9,0,0,0"
                                MinHeight="36" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButton}"
                                Margin="9,0,0,0"
                                MinHeight="36" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="240" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,17,20,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACTIVITY LOG" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{Binding Status}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Open log folder"
                                Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="12,0,0,0" />
                        <Button Grid.Column="2"
                                Content="Clear all"
                                Command="{Binding ClearAllLogsCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="8,0,0,0" />
                        <Button Grid.Column="3"
                                Content="Copy selected"
                                Command="{Binding CopySelectedLogCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="8,0,0,0" />
                        <Button Grid.Column="4"
                                Content="Copy all"
                                Command="{Binding CopyAllLogsCommand}"
                                Style="{StaticResource CompactButton}"
                                Margin="8,0,0,0" />
                    </Grid>
                    <ListBox x:Name="ActivityLogList"
                             Grid.Row="1"
                             ItemsSource="{Binding LiveLog}"
                             SelectedItem="{Binding SelectedLogLine, Mode=TwoWay}"
                             Style="{StaticResource LogList}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
