<UserControl x:Class="Deckino.Tools.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,32,36,40" MaxWidth="1180" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DATA PIPELINE" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource PageDescription}"
                               MaxWidth="720"
                               Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="24,0,0,2">
                    <Button Content="Sync all data"
                            Command="{Binding SyncCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="132" />
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding CancelCommand}"
                            ToolTip="Cancel sync"
                            Margin="8,0,0,0">
                        <Path Width="15"
                              Height="15"
                              Stretch="Uniform"
                              Stroke="{StaticResource Text.Primary}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M6 6l12 12M18 6L6 18" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding OpenArtFolderCommand}"
                            ToolTip="Open art folder"
                            Margin="4,0,0,0">
                        <Path Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Fill="{StaticResource Text.Primary}"
                              Data="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6zm2 2v9h14V8h-8l-2-2H5z" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,28,0,0" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                Background="{StaticResource Accent.Subtle}"
                                CornerRadius="12"
                                VerticalAlignment="Top">
                            <Ellipse Width="10" Height="10" Fill="{Binding StatusDotBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,20,0">
                            <TextBlock Text="SYNC STATUS" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{Binding StatusLine}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StatusDetail}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusDetail}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="CURRENT RUN" Style="{StaticResource EyebrowText}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding BulkProgressPercent, StringFormat='{}{0:0}%'}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Value="{Binding BulkProgressPercent}"
                                 Maximum="100"
                                 Margin="0,22,0,0"
                                 Height="8"
                                 Foreground="{StaticResource Accent}"
                                 Background="{StaticResource Bg.Inset}" />

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bulk download and art crop progress"
                                   Style="{StaticResource MonoText}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Command="{Binding CopyErrorCommand}"
                                ToolTip="Copy current status"
                                Width="32"
                                Height="32"
                                MinHeight="32">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="{StaticResource Text.Secondary}"
                                  Data="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{StaticResource Danger.Subtle}"
                            BorderBrush="{StaticResource Danger}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,14,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorDetail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="SYNC ERROR" Style="{StaticResource EyebrowText}" Foreground="{StaticResource Danger}" />
                            <TextBlock Text="{Binding ErrorDetail}"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       MaxHeight="80"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="22">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CACHE OVERVIEW" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Local data available to the training pipeline"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Scryfall → SQLite → local art"
                                   Style="{StaticResource MonoText}"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CARDS" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding CardsInDb, StringFormat='{}{0:N0}'}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="in SQLite" Style="{StaticResource MonoText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource Border.Subtle}" Margin="18,0" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ORACLE CARDS" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding OracleCardsInDb, StringFormat='{}{0:N0}'}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="unique identities" Style="{StaticResource MonoText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{StaticResource Border.Subtle}" Margin="18,0" />
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ART CACHED" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ImagesDone, StringFormat='{}{0:N0}'}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="ready locally" Style="{StaticResource MonoText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="5" Background="{StaticResource Border.Subtle}" Margin="18,0" />
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="ART PENDING" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ImagesPending, StringFormat='{}{0:N0}'}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0" />
                            <TextBlock Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImagesFailed}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding ImagesFailed, StringFormat='{}{0:N0} failed'}" Foreground="{StaticResource Danger}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding CacheProgressPercent}"
                                     Maximum="100"
                                     Style="{StaticResource SlimProgressBar}"
                                     VerticalAlignment="Center"
                                     Background="{StaticResource Bg.Inset}"
                                     Foreground="{StaticResource Success}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CacheProgressPercent, StringFormat='{}{0:0}% cached'}"
                                   Style="{StaticResource MonoText}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
