{
  "name": "deckino-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen:api": "npx --yes openapi-typescript@7.13.0 ../openapi/deckino.json -o src/generated.ts --root-types --root-types-no-schema-prefix",
    "typecheck": "npm run gen:api && tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "e2e": "playwright test",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@mantine/core": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@material-symbols/svg-400": "0.48.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
